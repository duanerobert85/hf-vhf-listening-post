[Unit]
Description=Scanner HDMI GUI
After=piscan.service
Requires=piscan.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/hf-vhf-listening-post/gui
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=/usr/bin/python3 /home/%i/hf-vhf-listening-post/gui/scanner_gui.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
